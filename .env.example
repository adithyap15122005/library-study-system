# Create a MySQL database and user first. URL-encode credentials with special characters.
DATABASE_URL=mysql+pymysql://library_user:replace_password@127.0.0.1:3306/library_study?charset=utf8mb4
# Use a different, disposable database for pytest. Tests rebuild its project tables.
TEST_DATABASE_URL=mysql+pymysql://library_user:replace_password@127.0.0.1:3306/library_study_test?charset=utf8mb4
# Generate each secret separately with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_random_session_secret
LEDGER_SECRET=replace_with_an_independent_random_ledger_secret
BORROW_DAYS=14
# Use 1 when serving over HTTPS. Loopback HTTP development uses 0.
SESSION_COOKIE_SECURE=0
# Local demonstration account passwords, each at least 8 characters.
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=
